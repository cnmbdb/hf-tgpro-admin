ALLOWED_DOMAINS=your-domain.com,bot.your-domain.com
CURRENT_DOMAIN=your-domain.com

ENERGY_POOL_ALLOWED_DOMAINS=your-domain.com,bot.your-domain.com
LICENSE_DOMAIN=your-domain.com

# Telegram Bot Webhook 配置
BOT_CURRENT_DOMAIN=https://bot.your-domain.com

#能量池/授权系统API账号与密码
ENERGY_POOL_API_USERNAME=
ENERGY_POOL_API_PASSWORD=

# ========================================
# Cloudflare Tunnel 配置
# ========================================
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARED_TOKEN=your-cloudflared-token
CLOUDFLARE_TUNNEL_ID=your-tunnel-uuid

# ========================================
# Cloudflare Turnstile 验证码配置
# ========================================
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

TON_API_GATEWAY_TOKEN=your-ton-api-gateway-token

#########以下的无需修改###################

# ========================================
# TGPro 管理系统 - 统一环境配置文件
# ========================================
# 重要：所有服务（前端、后端API、Telegram机器人）都读取这个文件
# 修改此文件后需要重启所有服务才能生效
WEBHOOK_MODE=true
WEBHOOK_PATH=/api/bot-webhook
BOT_WEBHOOK_PATH=/webhook
LICENSE_SERVER_IP=
# ========================================
# 安全访问配置
# ========================================
ALLOW_IP_ACCESS=false
ALLOW_DOMAIN_ACCESS=true
# ========================================
# 版本与安全配置
# ========================================
APP_VERSION=2026.1.33
ADMIN_PORT=58899
ADMIN_PATH=your-admin-path
# 当前登录入口: http://your-domain:58899/your-admin-path
NUXT_SECRET_KEY=your-nuxt-secret-key
NUXT_PUBLIC_API_BASE=/api

# ========================================
# 测试环境配置（开发专用）
# ========================================
DEBUG_LOGIN_ENABLED=true
DEBUG_USERNAME=admin
DEBUG_PASSWORD=your-debug-password

# ========================================
# 应用配置
# ========================================
NODE_ENV=production
NUXT_HOST=0.0.0.0
NUXT_PORT=58899

# ========================================
# 数据库配置
# ========================================
DB_HOST=db
DB_PORT=3306
DB_NAME=hftgpro
DB_USER=hftgpro
DB_PASSWORD=your-db-password
DB_ROOT_PASSWORD=your-db-root-password

# ========================================
# 能量池系统授权配置
# ========================================
ENERGY_POOL_LICENSE_API=https://your-license-api.example.com

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=info
LOG_FILE=/var/log/tgpro/app.log
TZ=Asia/Shanghai

# ========================================
# Telegram 机器人配置
# ========================================
BOT_TOKEN=your-telegram-bot-token
BOT_CONTROL_ADDRESS=your-tron-address
BOT_CUSTOMER_SERVICE_ID=https://t.me/your-customer-service
BOT_TIAOZHUAN=https://t.me/your-bot
BOT_ADMIN_ID=your-admin-telegram-id
BOT_THREE_PRICE=15
BOT_SIX_PRICE=22
BOT_YEAR_PRICE=40

# ========================================
# Fragment.com 配置
# ========================================
ResHash=your-fragment-hash
ResCookie=your-fragment-cookie

# ========================================
# Telegram 钱包助记词
# ========================================
WalletMnemonic="your wallet mnemonic words separated by spaces"

# ========================================
# Tron API 配置
# ========================================
TRON_API_KEY=your-tron-api-key

# ========================================
# TON API 端点配置
# ========================================
TON_API_GATEWAY=https://your-ton-api-gateway.example.com
